# ═══════════════════════════════════════════════════════
#  AMC Facturación Electrónica — Variables de entorno
#  Copiar este archivo como .env y ajustar los valores
# ═══════════════════════════════════════════════════════

# ── Servidor ────────────────────────────────────────────
NODE_ENV=development
PORT=3000

# ── Base de datos PostgreSQL ─────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=amc_facturacion
DB_USER=amc_app
DB_PASSWORD=CAMBIAR_EN_PRODUCCION
DB_MAX_CONNECTIONS=20
DB_IDLE_TIMEOUT_MS=30000

# ── Respaldos PostgreSQL ─────────────────────────────────
# Nunca use una carpeta dentro del proyecto. Proteja el destino con cifrado.
AMC_BACKUP_DIR=D:\AMC-Backups
PG_BIN_DIR=C:\Program Files\PostgreSQL\18\bin
DB_CONNECTION_TIMEOUT_MS=2000

# ── Superadmin DB (solo para migraciones) ───────────────
DB_SUPERUSER=postgres
DB_SUPERPASSWORD=CAMBIAR_EN_PRODUCCION

# ── JWT ──────────────────────────────────────────────────
# Generar con: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=CAMBIAR_A_UN_STRING_ALEATORIO_DE_64_BYTES_EN_PRODUCCION
JWT_EXPIRES_IN=8h
JWT_REFRESH_EXPIRES_IN=7d

# ── CORS ─────────────────────────────────────────────────
# En producción, especificar el dominio exacto del frontend
CORS_ORIGIN=http://localhost:5500,http://127.0.0.1:5500

# ── Rate Limiting ────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
AUTH_RATE_LIMIT_MAX=10

# ── Bcrypt ───────────────────────────────────────────────
BCRYPT_ROUNDS=12

# ── Logs ─────────────────────────────────────────────────
LOG_LEVEL=info
